{
  "info": {
    "_postman_id": "h01-onboarding-wallet-kyc",
    "name": "H-01 Onboarding, Wallet y KYC",
    "description": "Colección de pruebas del contrato H-01 (registro, autenticación, wallet, contactos y KYC). Ejecutar en orden: las pruebas dependen de un estado creado por las peticiones previas. Autenticación: HTTP Basic (email:password) en todos los endpoints salvo POST /users.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8090", "type": "string" },
    { "key": "email", "value": "", "type": "string" },
    { "key": "password", "value": "password123", "type": "string" },
    { "key": "walletId", "value": "", "type": "string" },
    { "key": "contactWalletId", "value": "00000000-0000-0000-0000-000000000000", "type": "string" }
  ],
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{email}}", "type": "string" },
      { "key": "password", "value": "{{password}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "1. Registro de usuario",
      "item": [
        {
          "name": "POST /users - Registrar usuario (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('email')) {",
                  "  pm.collectionVariables.set('email', 'user-' + Date.now() + '@example.com');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Respuesta sin password', () => pm.expect(pm.response.json()).to.not.have.property('password'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Perez\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"+51999999999\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "POST /users - Email duplicado (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "pm.test('Código EMAIL_ALREADY_REGISTERED', () => pm.expect(pm.response.json().code).to.eql('EMAIL_ALREADY_REGISTERED'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Perez\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"+51999999999\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "POST /users - Datos inválidos (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Código VALIDATION_FAILED con fields', () => { const b = pm.response.json(); pm.expect(b.code).to.eql('VALIDATION_FAILED'); pm.expect(b.fields).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana\",\n  \"email\": \"no-es-email\",\n  \"phone\": \"123\",\n  \"password\": \"corta\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/users"
          }
        }
      ]
    },
    {
      "name": "2. Autenticación",
      "item": [
        {
          "name": "POST /auth/login - Credenciales correctas (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve el email autenticado', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('email')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "POST /auth/login - Clave incorrecta (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Header WWW-Authenticate', () => pm.response.to.have.header('WWW-Authenticate', 'Basic realm=\"hackathon-backend\"'));",
                  "pm.test('Código UNAUTHORIZED', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{email}}", "type": "string" },
                { "key": "password", "value": "clave-incorrecta", "type": "string" }
              ]
            },
            "method": "POST",
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "GET /wallet - Sin credenciales (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/wallet"
          }
        }
      ]
    },
    {
      "name": "3. Wallet",
      "item": [
        {
          "name": "GET /wallet - Aún sin wallet (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('Código WALLET_NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('WALLET_NOT_FOUND'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallet"
          }
        },
        {
          "name": "POST /wallet - Activar wallet (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('payments_enabled es false antes de KYC', () => pm.expect(pm.response.json().payments_enabled).to.eql(false));",
                  "pm.collectionVariables.set('walletId', pm.response.json().wallet_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wallet"
          }
        },
        {
          "name": "POST /wallet - Wallet ya existente (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "pm.test('Código WALLET_ALREADY_EXISTS', () => pm.expect(pm.response.json().code).to.eql('WALLET_ALREADY_EXISTS'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wallet"
          }
        },
        {
          "name": "GET /wallet - Consultar wallet (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('wallet_id coincide con el creado', () => pm.expect(pm.response.json().wallet_id).to.eql(pm.collectionVariables.get('walletId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallet"
          }
        }
      ]
    },
    {
      "name": "4. Contactos",
      "item": [
        {
          "name": "POST /contacts - Wallet inexistente (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "pm.test('Código WALLET_NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('WALLET_NOT_FOUND'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Luis\",\n  \"phone\": \"+51988888888\",\n  \"wallet_id\": \"{{contactWalletId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/contacts"
          }
        },
        {
          "name": "POST /contacts - Contacto válido (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('wallet_id del contacto coincide', () => pm.expect(pm.response.json().wallet_id).to.eql(pm.collectionVariables.get('walletId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Luis\",\n  \"phone\": \"+51988888888\",\n  \"wallet_id\": \"{{walletId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/contacts"
          }
        },
        {
          "name": "GET /contacts - Listar contactos (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es un arreglo con al menos un contacto', () => pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/contacts"
          }
        }
      ]
    },
    {
      "name": "5. KYC",
      "item": [
        {
          "name": "GET /kyc/verifications - Sin verificación (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('Código KYC_NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('KYC_NOT_FOUND'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/kyc/verifications"
          }
        },
        {
          "name": "POST /kyc/verifications - documentType inválido (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Código VALIDATION_FAILED', () => pm.expect(pm.response.json().code).to.eql('VALIDATION_FAILED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"LICENSE\",\n  \"documentNumber\": \"12345678\",\n  \"fullName\": \"Ana Perez\",\n  \"birthDate\": \"1990-01-31\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/kyc/verifications"
          }
        },
        {
          "name": "POST /kyc/verifications - Enviar KYC (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Estado approved', () => pm.expect(pm.response.json().status).to.eql('approved'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"12345678\",\n  \"fullName\": \"Ana Perez\",\n  \"birthDate\": \"1990-01-31\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/kyc/verifications"
          }
        },
        {
          "name": "GET /wallet - payments_enabled tras KYC (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('payments_enabled es true', () => pm.expect(pm.response.json().payments_enabled).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallet"
          }
        },
        {
          "name": "GET /kyc/verifications - Última verificación (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Estado approved', () => pm.expect(pm.response.json().status).to.eql('approved'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/kyc/verifications"
          }
        },
        {
          "name": "POST /kyc/verifications - Ya aprobado (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "pm.test('Código KYC_ALREADY_APPROVED', () => pm.expect(pm.response.json().code).to.eql('KYC_ALREADY_APPROVED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"12345678\",\n  \"fullName\": \"Ana Perez\",\n  \"birthDate\": \"1990-01-31\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/kyc/verifications"
          }
        }
      ]
    }
  ]
}
